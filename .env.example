# =========================================
# ENVIRONMENT VARIABLES - Kennel Manager Pro
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control
# =========================================

# ---------- DATABASE ----------
# PostgreSQL connection string from Supabase
#
# Para Vercel/produção: use a POOLER URL (Transaction mode)
#   Supabase Dashboard → Settings → Database → Connection string → URI → Transaction
#   Formato: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Para desenvolvimento local: conexão direta funciona
#   Formato: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
#
# ⚠️ Requisitos da senha:
#   - Mínimo 32 caracteres
#   - Usar caracteres especiais (Supabase gera senhas fortes automaticamente)
#   - Para gerar nova senha: Supabase Dashboard → Settings → Database → Reset Password
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# ---------- SUPABASE ----------
# Chave pública (safe para frontend)
# Supabase Dashboard → Settings → API → Project API Keys → anon / public
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# ⚠️ SEGREDO - NUNCA exponha no frontend ou faça commit.
# Usar APENAS em código server-side (Express routes, server.ts).
# Supabase Dashboard → Settings → API → Project API Keys → service_role / secret
# Para rotacionar: Dashboard → Settings → API → Reset API Key
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_YOUR_KEY_HERE"

# ---------- JWT ----------
# DEVE ser idêntico ao JWT Secret configurado no Supabase Dashboard
# Se não bater, todos os tokens JWT serão inválidos.
#
# Supabase Dashboard → Authentication → Settings → JWT Settings → JWT Secret
#
# ⚠️ Requisitos do segredo:
#   - Mínimo 64 caracteres (recomendado: 96+)
#   - Usar caracteres aleatórios (não phrases legíveis)
#   - Gerar com: .\scripts\rotate-credentials.ps1 (PowerShell)
#   - Ou usar: openssl rand -base64 48
#
# ⚠️ Ao rotacionar: todos os tokens ativos serão invalidados
JWT_SECRET="YOUR_JWT_SECRET_HERE_MIN_64_CHARS"

# ---------- APPLICATION ----------
# "development" ou "production"
NODE_ENV="development"

# ---------- CORS ----------
# Domínios permitidos (separados por vírgula)
# Em produção, listar APENAS os domínios reais
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ---------- SSL (Opcional) ----------
# Para Supabase, SSL validation é desabilitado por padrão (certificado self-signed).
# Para habilitar validação SSL estrita (produção com connection pooling):
# DB_SSL_REJECT_UNAUTHORIZED="true"
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n..."

# ---- END OF REQUIRED VARIABLES ----
