# =========================================
# ENVIRONMENT VARIABLES - Kennel Manager Pro
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control
# =========================================

# ---------- DATABASE ----------
# PostgreSQL connection string from Supabase
# For Vercel/external hosts: use the POOLER URL (Transaction mode)
#   Settings -> Database -> Connection string -> URI -> Transaction
#   Format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# For local development: direct connection works fine
#   Format: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# ---------- SUPABASE ----------
# Public anon key - safe to expose in frontend
# Settings -> API -> Project API Keys -> anon / public
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# ⚠️ KEEP SECRET - NEVER expose to frontend or commit. Use only in backend/server-side code.
# Settings -> API -> Project API Keys -> service_role / secret
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_YOUR_KEY_HERE"

# ---------- JWT ----------
# Must match the JWT Secret in Supabase Auth settings
# Generate a strong secret: use 32+ random characters
# Authentication -> Settings -> JWT Settings -> JWT Secret
JWT_SECRET="YOUR_JWT_SECRET_HERE_USE_32_CHARS_MIN"

# ---------- SSL ----------
# For Supabase, SSL validation is disabled by default (self-signed cert).
# Set to "true" and provide DB_CA_CERT to enable strict SSL validation.
# DB_SSL_REJECT_UNAUTHORIZED="false"
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n..."

# ---------- CORS ----------
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ---- END OF REQUIRED VARIABLES ----
