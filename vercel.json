{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/*.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "github": {
    "silent": true
  }
}
